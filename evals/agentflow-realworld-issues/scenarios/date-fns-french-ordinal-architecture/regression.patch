@@ -0,0 +1,26 @@
+import { fr } from "../../locale/fr/index.js";
+import { format } from "../index.js";
+
+function assertEqual(actual: string, expected: string): void {
+  if (actual !== expected) {
+    throw new Error(`Expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
+  }
+}
+
+assertEqual(
+  format(new Date(2019, 7 /* Aug */, 1), "iiii do MMMM yyyy", {
+    locale: fr,
+  }),
+  "jeudi 1er août 2019",
+);
+
+assertEqual(
+  format(new Date(2019, 7 /* Aug */, 29), "iiii do MMMM yyyy", {
+    locale: fr,
+  }),
+  "jeudi 29 août 2019",
+);
+
+assertEqual(format(new Date(2019, 7 /* Aug */, 29), "do MMMM", { locale: fr }), "29 août");
+
+console.log("Agentflow French ordinal regression passed.");
