+import test from './testFunctions';
+
+describe('Agentflow real-world regression: URL hostnames with ports', () => {
+  it('accepts hostnames with numeric ports when protocol is not required', () => {
+    test({
+      validator: 'isURL',
+      args: [{
+        require_tld: false,
+        require_valid_protocol: false,
+      }],
+      valid: [
+        'localhost:3000',
+        'service-name:8080',
+        'my-3272-service:9000',
+        'user:pass@service-name:8080',
+        'http://localhost:3000',
+      ],
+      invalid: [],
+    });
+  });
+
+  it('still rejects protocol-less hostnames with ports when protocol is required', () => {
+    test({
+      validator: 'isURL',
+      args: [{
+        require_tld: false,
+        require_protocol: true,
+        require_valid_protocol: false,
+      }],
+      valid: [
+        'http://localhost:3000',
+        'https://service-name:8080',
+        'custom://localhost',
+      ],
+      invalid: [
+        'localhost:3000',
+        'service-name:8080',
+        'user:pass@service-name:8080',
+      ],
+    });
+  });
+});
