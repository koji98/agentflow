+import test from 'ava';
+import {$} from '../../index.js';
+import {setFixtureDirectory} from '../helpers/fixtures-directory.js';
+
+setFixtureDirectory();
+
+const testScriptStdout = async (t, getSubprocess, expectedStdout) => {
+  const {stdout} = await getSubprocess();
+  t.is(stdout, expectedStdout);
+};
+
+test('$ can use escaped newlines and space indentation', testScriptStdout, () => $`echo.js foo\
+  bar`, 'foo\nbar');
+
+test('$ can use escaped newlines and tab indentation', testScriptStdout, () => $`echo.js foo\
+	bar`, 'foo\nbar');
+
+test('$ can use escaped newlines with escaped tab characters after the newline', testScriptStdout, () => $`echo.js foo\
+\tbar`, 'foo\tbar');
+
+test('$ can use escaped newlines with escaped newline characters after the newline', testScriptStdout, () => $`echo.js foo\
+\n\nbar`, 'foo\n\nbar');
