{
  "id": "declared-artifact-discipline",
  "bucket": "valid-hard-execution",
  "difficulty": "hard",
  "description": "Clear graph where the node must write the declared artifact, not rely on final text.",
  "measurement": {
    "claim": "Agentflow should satisfy this scenario's observable workflow contract: Clear graph where the node must write the declared artifact, not rely on final text.",
    "scenario_type": "capability:valid-hard-execution",
    "metrics": [
      "final outcome",
      "artifact evidence",
      "workspace scope",
      "supervisor recovery",
      "delivery auditability",
      "custom deterministic checks",
      "scenario-specific checks",
      "quality rubric"
    ],
    "expected_failure_modes": [
      "final outcome differs from expected status",
      "required artifact is missing, stale, placeholder, or unsupported",
      "workspace changes are missing, forbidden, or out of scope",
      "expected supervisor recovery, learning, or authority behavior is missing",
      "delivery package is missing, unsupported, or not review-ready",
      "scenario-specific deterministic or quality criterion failed",
      "quality rubric finds weak evidence, scope control, or handoff quality"
    ],
    "tweak_signal": "Inspect supervisor classification, material delta, recovery learning, authority policy, retry packet shape, and whether the agent used recovery evidence."
  },
  "workflow": {
    "graph_template": "../../shared/graph.exec.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true
  },
  "criteria": {
    "outcome": {
      "status": "passed"
    },
    "artifact": {
      "required": [
        {
          "name": "handoff",
          "contains": [
            "validation"
          ]
        }
      ]
    },
    "workspace": {
      "forbidden_edits": [
        "forbidden.txt"
      ]
    },
    "supervisor": {},
    "delivery": {
      "required": true
    },
    "workflow-deterministic": {},
    "contract-adherence": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "artifact-quality": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "evidence-use": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "supervisor-recovery": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "context-handling": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "tool-discipline": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "noise-efficiency": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "delivery-auditability": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    }
  }
}
