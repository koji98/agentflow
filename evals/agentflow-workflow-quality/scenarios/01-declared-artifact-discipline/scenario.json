    "supervisor-recovery": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "context-handling": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "tool-discipline": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "noise-efficiency": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    },
    "delivery-auditability": {
      "dimensions": [
        "artifact_quality",
        "delivery_auditability"
      ]
    }
  }
