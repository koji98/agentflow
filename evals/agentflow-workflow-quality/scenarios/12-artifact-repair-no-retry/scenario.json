{
  "id": "artifact-repair-no-retry",
  "bucket": "valid-hard-execution",
  "difficulty": "hard",
  "description": "Supervisor should repair missing artifact directly when final response contains enough evidence.",
  "measurement": {
    "claim": "Agentflow should satisfy this scenario's observable workflow contract: Supervisor should repair missing artifact directly when final response contains enough evidence.",
    "scenario_type": "capability:valid-hard-execution",
    "metrics": [
      "final outcome",
      "artifact evidence",
      "workspace scope",
      "supervisor recovery",
      "delivery auditability",
      "custom deterministic checks",
      "scenario-specific checks",
      "quality rubric"
    ],
    "expected_failure_modes": [
      "final outcome differs from expected status",
      "required artifact is missing, stale, placeholder, or unsupported",
      "workspace changes are missing, forbidden, or out of scope",
      "expected supervisor recovery, learning, or authority behavior is missing",
      "delivery package is missing, unsupported, or not review-ready",
      "scenario-specific deterministic or quality criterion failed",
      "quality rubric finds weak evidence, scope control, or handoff quality"
    ],
    "tweak_signal": "Inspect supervisor classification, material delta, recovery learning, authority policy, retry packet shape, and whether the agent used recovery evidence."
  },
  "workflow": {
    "graph_template": "../../shared/graph.exec.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true
  },
  "criteria": {
    "outcome": {
      "status": "passed"
    },
    "artifact": {
      "required": [
        {
          "name": "handoff",
          "contains": [
            "scenario=artifact-repair-no-retry"
          ]
        }
      ]
    },
    "workspace": {
      "forbidden_edits": [
        "unnecessary-retry.txt"
      ]
    },
    "supervisor": {
      "apply_actions": [
        "repair_artifact"
      ]
    },
    "delivery": {
      "required": true
    },
    "workflow-deterministic": {},
    "contract-adherence": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "artifact-quality": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "evidence-use": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "supervisor-recovery": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "context-handling": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "tool-discipline": {
      "dimensions": [
        "supervisor_recovery_quality",
        "artifact_quality"
      ]
    },
    "noise-efficiency": {
      "dimensions": [
        "supervisor_recovery_quality",
