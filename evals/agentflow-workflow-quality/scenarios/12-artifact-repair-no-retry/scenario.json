{
  "id": "artifact-repair-no-retry",
  "bucket": "valid-hard-execution",
  "difficulty": "hard",
  "description": "Supervisor should repair missing artifact directly when final response contains enough evidence.",
  "workflow": {
    "graph_template": "../../shared/graph.exec.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true
  },
  "criteria": {
    "outcome": {
      "status": "passed"
    },
    "artifact": {
      "required": [
        {
          "name": "handoff",
          "contains": [
            "scenario=artifact-repair-no-retry"
          ]
        }
      ]
    },
    "workspace": {
      "forbidden_edits": [
        "unnecessary-retry.txt"
      ]
    },
    "supervisor": {
      "apply_actions": [
        "repair_artifact"
      ]
    },
    "delivery": {
      "required": true
    },
    "workflow-deterministic": {},
    "contract-adherence": {
