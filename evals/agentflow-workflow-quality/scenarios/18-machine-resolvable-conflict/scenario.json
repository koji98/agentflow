{
  "id": "machine-resolvable-conflict",
  "bucket": "valid-noisy-evidence",
  "difficulty": "hard",
  "description": "Supervisor should resolve evidence conflict using machine-readable local metadata, not human pause.",
  "measurement": {
    "claim": "Agentflow should satisfy this scenario's observable workflow contract: Supervisor should resolve evidence conflict using machine-readable local metadata, not human pause.",
    "scenario_type": "capability:valid-noisy-evidence",
    "metrics": [
      "final outcome",
      "artifact evidence",
      "workspace scope",
      "supervisor recovery",
      "delivery auditability",
      "custom deterministic checks",
      "scenario-specific checks",
      "quality rubric"
    ],
    "expected_failure_modes": [
      "final outcome differs from expected status",
      "required artifact is missing, stale, placeholder, or unsupported",
      "workspace changes are missing, forbidden, or out of scope",
      "expected supervisor recovery, learning, or authority behavior is missing",
      "delivery package is missing, unsupported, or not review-ready",
      "scenario-specific deterministic or quality criterion failed",
      "quality rubric finds weak evidence, scope control, or handoff quality"
    ],
    "tweak_signal": "Inspect supervisor classification, material delta, recovery learning, authority policy, retry packet shape, and whether the agent used recovery evidence."
  },
  "workflow": {
    "graph_template": "../../shared/graph.exec.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true,
    "docs": "../../shared/docs"
  },
  "criteria": {
    "outcome": {
      "status": "passed"
    },
    "artifact": {
      "required": [
        {
          "name": "handoff",
          "contains": [
            "scenario=machine-resolvable-conflict"
          ]
        }
      ]
    },
    "workspace": {
      "forbidden_edits": [
        "human-pause-needed.txt"
      ]
    },
    "supervisor": {
      "gatherers": [
        "dependency_metadata"
      ],
      "forbidden_apply_actions": [
        "pause_for_authority"
      ]
    },
    "delivery": {
      "required": true
    },
    "workflow-deterministic": {},
    "contract-adherence": {
      "dimensions": [
        "supervisor_recovery_quality",
        "evidence_use"
      ]
    },
    "artifact-quality": {
      "dimensions": [
        "supervisor_recovery_quality",
        "evidence_use"
      ]
    },
    "evidence-use": {
