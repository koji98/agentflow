{
  "version": "1",
  "graph_id": "capability-{{scenario.id}}-{{variant.id}}-{{trial.index}}",
  "intent": {
    "goal": "{{scenario.description}}",
    "acceptance_criteria": [
      "The workflow satisfies the fixture repository validation.",
      "The delivery package contains enough evidence for eval grading."
    ],
    "constraints": [
      "Do not use sources outside the local repo, docs, and tool fixtures supplied by this eval.",
      "Do not use public network sources."
    ]
  },
  "repos": {
    "main": {
      "path": "{{environment.repo}}"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "{{workflow.workspace_backend}}"
  },
  "profiles": {
    "default": {
      "harness": "{{workflow.harness}}",
      "model": "gpt-5.4-mini",
      "reasoning_effort": "low",
      "sandbox": "workspace-write",
      "timeout_sec": 900
    },
    "supervisor": {
      "harness": "codex-cli",
      "sandbox": "read-only"
    }
  },
  "supervision": {
    "max_total_interventions": 2,
    "profile": "supervisor"
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "exec",
        "id": "always_fail",
        "repo": "main",
        "command": "node",
        "args": [
          "scripts/always-fail.js"
        ],
        "intent": {
          "goal": "Exercise an unrecoverable exec failure for eval grading.",
          "acceptance_criteria": [
            "The fixture command fails deterministically.",
            "The run records terminal failure evidence without fabricating success."
          ],
          "constraints": []
        }
      }
    ]
  }
}
