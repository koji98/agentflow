{
  "version": "1",
  "graph_id": "capability-{{scenario.id}}-{{variant.id}}-{{trial.index}}",
  "intent": {
    "goal": "{{scenario.description}}",
    "acceptance_criteria": [
      "The workflow satisfies the fixture repository validation.",
      "The delivery package contains enough evidence for eval grading."
    ],
    "constraints": [
      "Use only local repo, docs, and tool fixtures supplied by this eval.",
      "Do not use public network sources."
    ]
  },
  "repos": {
    "main": {
      "path": "{{environment.repo}}"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "{{workflow.workspace_backend}}"
  },
  "profiles": {
    "default": {
      "harness": "{{workflow.harness}}",
      "model": "gpt-5.4-mini",
      "reasoning_effort": "low",
      "sandbox": "workspace-write",
      "timeout_sec": 900
    },
    "supervisor": {
      "harness": "codex-cli",
      "sandbox": "read-only"
    }
  },
  "supervision": {
    "max_total_interventions": 1,
    "profile": "supervisor"
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "exec",
        "id": "retry_gate",
        "repo": "main",
        "command": "node",
        "args": [
          "scripts/retry-gate.js"
        ],
        "artifacts": {
          "handoff": {
            "from": "output_dir",
            "path": "handoff.md",
            "description": "Recovery envelope handoff."
          }
        },
        "intent": {
          "goal": "Exercise the retry-envelope recovery gate and publish the recovery handoff when the fixture allows it.",
          "acceptance_criteria": [
            "The command succeeds only after receiving useful supervisor recovery context.",
            "The declared handoff artifact records the recovery evidence."
          ],
          "constraints": []
        }
      }
    ]
  }
}
