{
  "id": "pointer-provenance",
  "bucket": "context-authority",
  "difficulty": "hard",
  "description": "Agent must inspect pointer provenance before relying on context evidence.",
  "workflow": {
    "graph_template": "../../templates/agent.graph.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true
  },
  "criteria": {
    "outcome": { "status": "passed" },
    "artifact": { "required": [{ "name": "handoff", "contains": ["provenance"] }] },
    "delivery": { "required": true },
    "prompt-regression": {
      "task": "Inspect the context packet/provenance before writing the handoff. The handoff must include the word `provenance` and explain which pointer source you relied on.",
      "required_contains": ["provenance", "Scenario:", "Evidence:"],
      "required_af": ["orient", "complete check"]
    }
  }
}
