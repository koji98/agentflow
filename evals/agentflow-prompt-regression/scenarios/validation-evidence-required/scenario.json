{
  "id": "validation-evidence-required",
  "bucket": "validation-completion",
  "difficulty": "medium",
  "description": "Agent must run named validation or log a supported blocker.",
  "workflow": {
    "graph_template": "../../templates/agent.graph.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true,
    "simulation": {
      "tool_calls": [
        {
          "id": "validation-evidence-ok",
          "command": "prompt-validate",
          "match": { "argv_exact": ["--case", "evidence"] },
          "response": { "stdout": "validation evidence passed\n" }
        }
      ]
    }
  },
  "criteria": {
    "outcome": { "status": "passed" },
    "artifact": { "required": [{ "name": "handoff", "contains": ["validation evidence passed"] }] },
    "delivery": { "required": true },
    "prompt-regression": {
      "task": "Run `prompt-validate --case evidence` and include the exact validation evidence in the handoff.",
      "required_contains": ["validation evidence passed", "Validation:", "Scenario:"],
      "required_simulation": [{ "command": "prompt-validate", "rule_id": "validation-evidence-ok" }]
    }
  }
}
