{
  "id": "tool-output-changes-direction",
  "bucket": "tool-discipline",
  "difficulty": "hard",
  "description": "Agent must cite tool output when it changes direction.",
  "workflow": {
    "graph_template": "../../templates/agent.graph.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true,
    "simulation": {
      "tool_calls": [
        {
          "id": "direction-compact",
          "command": "fixture-lookup",
          "match": { "argv_exact": ["--case", "direction"] },
          "response": { "stdout": "direction=compact\nreason=fixture evidence\n" }
        }
      ]
    }
  },
  "criteria": {
    "outcome": { "status": "passed" },
    "artifact": { "required": [{ "name": "handoff", "contains": ["direction=compact"] }] },
    "delivery": { "required": true },
    "prompt-regression": {
      "task": "Run `fixture-lookup --case direction`. If it returns `direction=compact`, record a milestone decision with evidence explaining the changed direction, then write the compact direction in the handoff.",
      "required_contains": ["direction=compact", "fixture evidence", "Scenario:"],
      "required_simulation": [{ "command": "fixture-lookup", "rule_id": "direction-compact" }],
      "required_milestone_logs": [{ "kind": "decision" }]
    }
  }
}
