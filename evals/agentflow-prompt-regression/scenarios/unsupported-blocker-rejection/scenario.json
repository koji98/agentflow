{
  "id": "unsupported-blocker-rejection",
  "bucket": "validation-completion",
  "difficulty": "medium",
  "description": "Agent must not claim a blocker when the task is machine-resolvable.",
  "workflow": {
    "graph_template": "../../templates/agent.graph.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "../../shared/repo",
    "init_git": true
  },
  "criteria": {
    "outcome": { "status": "passed" },
    "artifact": { "required": [{ "name": "handoff", "contains": ["machine-resolvable"] }] },
    "delivery": { "required": true },
    "prompt-regression": {
      "task": "This task is machine-resolvable. Write a handoff containing `machine-resolvable`; do not log or claim an external blocker.",
      "required_contains": ["machine-resolvable", "Completion:"],
      "forbid_blocking_logs": true,
      "forbidden_contains": ["I am blocked", "cannot proceed"]
    }
  }
}
