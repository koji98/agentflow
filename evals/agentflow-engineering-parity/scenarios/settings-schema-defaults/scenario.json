{
  "id": "settings-schema-defaults",
  "bucket": "engineering-parity",
  "difficulty": "medium",
  "description": "Normalize a settings schema with defaults and validation.",
  "workflow": {
    "graph_template": "../../templates/primitive-agent.graph.template.json",
    "harness": "codex-cli",
    "workspace_backend": "inplace"
  },
  "environment": {
    "repo": "repo",
    "init_git": true
  },
  "metadata": {
    "validation_command": "npm test"
  },
  "criteria": {
    "outcome": {
      "status": "passed"
    },
    "artifact": {
      "required": [
        {
          "name": "handoff",
          "contains": [
            "npm test"
          ]
        }
      ]
    },
    "workspace": {
      "forbidden_edits": [
        "task.md",
        "package.json"
      ]
    },
    "delivery": {
      "required": true
    },
    "engineering-parity": {}
  }
}
