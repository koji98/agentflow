{
  "version": "1",
  "graph_id": "repeat-graph",
  "intent": {
    "goal": "Exercise repeat graph compilation and runtime behavior.",
    "acceptance_criteria": [
      "The repeat graph compiles with supervised v1 contract fields."
    ]
  },
  "repos": {
    "main": {
      "path": ".",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "sandbox": "workspace-write"
    },
    "review": {
      "harness": "codex-cli",
      "sandbox": "read-only"
    },
    "supervisor": {
      "harness": "codex-cli",
      "sandbox": "read-only"
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "agent",
        "id": "understand",
        "artifacts": {
          "notes": {
            "from": "output_dir",
            "path": "notes.md",
            "description": "Markdown notes from the initial repository inspection."
          }
        },
        "intent": {
          "goal": "Inspect the checkout timeout flow.",
          "acceptance_criteria": [
            "The notes artifact explains the relevant timeout flow and likely repair areas."
          ],
          "constraints": []
        },
        "runtime": {
          "repo": "main"
        }
      },
      {
        "type": "parallel",
        "id": "preflight",
        "max_concurrency": 2,
        "steps": [
          {
            "type": "exec",
            "id": "lint",
            "command": "npm",
            "args": [
              "run",
              "lint"
            ],
            "intent": {
              "goal": "Run lint before the repair loop.",
              "acceptance_criteria": [
                "The lint command exits successfully."
              ],
              "constraints": []
            },
            "runtime": {
              "repo": "main"
            }
          },
          {
            "type": "exec",
            "id": "typecheck",
            "command": "npm",
            "args": [
              "run",
              "typecheck"
            ],
            "intent": {
              "goal": "Run typecheck before the repair loop.",
              "acceptance_criteria": [
                "The typecheck command exits successfully."
              ],
              "constraints": []
            },
            "runtime": {
              "repo": "main"
            }
          }
        ]
      },
      {
        "type": "repeat",
        "id": "repair_loop",
        "max_attempts": 3,
        "body": {
          "type": "sequence",
          "id": "repair_body",
          "steps": [
            {
              "type": "agent",
              "id": "implement_fix",
              "intent": {
                "goal": "Implement the timeout fix.",
                "acceptance_criteria": [
                  "The timeout behavior is fixed in source while preserving existing architecture."
                ],
                "constraints": []
              },
              "runtime": {
                "repo": "main"
              },
              "support": {
                "context": [
                  {
                    "name": "sources",
                    "path": "*.json",
                    "max_files": 4,
                    "kind": "workspace_glob",
                    "what": "Test context sources.",
                    "why": "Required by this test graph."
                  },
                  {
                    "ref": "understand.agent_response",
                    "name": "understand_response",
                    "kind": "artifact",
                    "what": "Test context understand_response.",
                    "why": "Required by this test graph."
                  }
                ]
              }
            },
            {
              "type": "agent",
              "id": "repair_notes",
              "intent": {
                "goal": "Review the fix and tighten any rough edges.",
                "acceptance_criteria": [
                  "The review identifies and addresses correctness or maintainability issues in the fix."
                ],
                "constraints": []
              },
              "runtime": {
                "repo": "main",
                "profile": "review"
              },
              "support": {
                "context": [
                  {
                    "ref": "implement_fix.agent_response",
                    "name": "implementation_response",
                    "kind": "artifact",
                    "what": "Test context implementation_response.",
                    "why": "Required by this test graph."
                  }
                ]
              }
            },
            {
              "type": "check",
              "id": "verify_fix",
              "check_kind": "deterministic",
              "command": "npm",
              "args": [
                "test"
              ],
              "pass_if": {
                "exit_code": 0
              },
              "artifacts": {
                "verification": {
                  "from": "output_dir",
                  "path": "verification.json",
                  "description": "Structured JSON verification result for the repair loop."
                }
              },
              "intent": {
                "goal": "Validate the timeout fix.",
                "acceptance_criteria": [
                  "The test command exits with code 0 and writes the verification artifact."
                ],
                "constraints": [
                  "Do not modify workspace files."
                ]
              },
              "runtime": {
                "repo": "main"
              }
            }
          ]
        },
        "until": {
          "node": "verify_fix"
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "intent": {
          "goal": "Summarize the fix and remaining risks.",
          "acceptance_criteria": [
            "The final handoff cites validation evidence and any remaining risks."
          ],
          "constraints": []
        },
        "runtime": {
          "repo": "main"
        },
        "support": {
          "context": [
            {
              "ref": "verify_fix.verification",
              "name": "verification",
              "iteration": "latest_passed",
              "kind": "artifact",
              "what": "Test context verification.",
              "why": "Required by this test graph."
            }
          ]
        }
      }
    ]
  },
  "supervision": {
    "profile": "supervisor",
    "max_total_interventions": 3
  }
}
