{
  "version": "1",
  "graph_id": "repeat-graph",
  "repos": {
    "main": {
      "path": ".",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "sandbox": "workspace-write",
      "timeout_sec": 1800,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    },
    "review": {
      "harness": "cursor-cli",
      "sandbox": "read-only",
      "timeout_sec": 900
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "agent",
        "id": "understand",
        "repo": "main",
        "prompt": "Inspect the checkout timeout flow.",
        "artifacts": {
          "notes": {
            "from": "output_dir",
            "path": "notes.md",
            "description": "Markdown notes from the initial repository inspection."
          }
        }
      },
      {
        "type": "parallel",
        "id": "preflight",
        "max_concurrency": 2,
        "steps": [
          {
            "type": "exec",
            "id": "lint",
            "repo": "main",
            "command": "npm",
            "args": [
              "run",
              "lint"
            ]
          },
          {
            "type": "exec",
            "id": "typecheck",
            "repo": "main",
            "command": "npm",
            "args": [
              "run",
              "typecheck"
            ]
          }
        ]
      },
      {
        "type": "repeat",
        "id": "repair_loop",
        "max_attempts": 3,
        "body": {
          "type": "sequence",
          "id": "repair_body",
          "steps": [
            {
              "type": "agent",
              "id": "implement_fix",
              "repo": "main",
              "prompt": "Implement the timeout fix.",
              "context": [
                {
                  "name": "sources",
                  "from": "workspace_glob",
                  "path": "src/**/*.ts",
                  "max_files": 4
                },
                {
                  "ref": "understand.agent_response",
                  "name": "understand_response"
                }
              ]
            },
            {
              "type": "agent",
              "id": "repair_notes",
              "repo": "main",
              "profile": "review",
              "prompt": "Review the fix and tighten any rough edges.",
              "context": [
                {
                  "ref": "implement_fix.agent_response",
                  "name": "implementation_response"
                }
              ]
            },
            {
              "type": "check",
              "id": "verify_fix",
              "repo": "main",
              "check_kind": "deterministic",
              "command": "npm",
              "args": [
                "test"
              ],
              "pass_if": {
                "exit_code": 0
              },
              "artifacts": {
                "verification": {
                  "from": "output_dir",
                  "path": "result.json",
                  "description": "Structured JSON verification result for the repair loop."
                }
              }
            }
          ]
        },
        "until": {
          "node": "verify_fix"
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "prompt": "Summarize the fix and remaining risks.",
        "context": [
          {
            "ref": "verify_fix.verification",
            "name": "verification",
            "iteration": "latest_passed"
          }
        ]
      }
    ]
  }
}
