 {
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone agentflow orchestrator with task/group/loop workflows for coding agents.",
  "bin": {
    "agentflow": "./bin/agentflow.js"
  },
  "scripts": {
    "start": "node ./bin/agentflow.js --help",
    "dev": "node ./bin/agentflow.js",
    "plan-help": "node ./bin/agentflow.js --plan-help",
    "web:dev": "npm --prefix web-app run dev",
    "web:build": "npm --prefix web-app run build",
    "web:start": "npm --prefix web-app run start",
    "fixtures:refresh-monitor": "node --import tsx scripts/refresh-monitor-sample-fixtures.ts",
    "setup:link": "npm link",
    "setup:unlink": "npm unlink --global agentflow",
    "test": "source ~/.nvm/nvm.sh && nvm exec 20 node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
