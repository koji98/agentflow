{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first graph executor for coding agents.",
  "engines": {
    "node": ">=20.7.0"
  },
  "bin": {
    "agentflow": "./dist/cli/index.js",
    "af": "./dist/af/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "help": "npm run dev --",
    "start": "node dist/cli/index.js --help",
    "run": "tsx src/cli/index.ts run",
    "validate": "tsx src/cli/index.ts validate",
    "graph-help": "tsx src/cli/index.ts graph-help",
    "resume": "tsx src/cli/index.ts resume",
    "apply": "tsx src/cli/index.ts apply",
    "runs": "tsx src/cli/index.ts runs",
    "inspect": "tsx src/cli/index.ts inspect",
    "setup:eval-repos": "node scripts/setup-eval-repos.mjs",
    "setup:realworld-evals": "node scripts/setup-realworld-evals.mjs",
    "setup:validation-evals": "node scripts/setup-realworld-evals.mjs --suite evals/agentflow-validation --repos-root eval-repos/agentflow-validation",
    "setup:link": "npm link",
    "setup:unlink": "npm unlink --global agentflow",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "node scripts/test-coverage.mjs",
    "build": "tsc -p tsconfig.json",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:smoke": "node scripts/validate-smoke.mjs",
    "validate:prompts": "vitest run tests/runtime/harness_prompt.test.ts tests/runtime/verification/prompt.test.ts tests/graph/deep_work.test.ts tests/graph/deep_research.test.ts tests/evals/suite.test.ts && tsx src/cli/index.ts eval run evals/agentflow-prompt-regression --variant current --trials 1 --concurrency 1",
    "validate:confidence": "node scripts/validate-confidence.mjs",
    "validate:release-confidence": "node scripts/validate-confidence.mjs --release",
    "validate:real-harness": "node scripts/validate-real-harness.mjs",
    "validate:real-evals": "node scripts/validate-real-evals.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
