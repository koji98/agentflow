{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first graph executor for coding agents.",
  "engines": {
    "node": ">=20.7.0"
  },
  "bin": {
    "agentflow": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "help": "npm run dev --",
    "start": "node dist/cli/index.js --help",
    "plan-help": "npm run graph-help",
    "run": "tsx src/cli/index.ts run",
    "validate": "tsx src/cli/index.ts validate",
    "compile": "tsx src/cli/index.ts compile",
    "graph-help": "tsx src/cli/index.ts graph-help",
    "control": "tsx src/cli/index.ts control",
    "resume": "tsx src/cli/index.ts resume",
    "setup:link": "npm link",
    "setup:unlink": "npm unlink --global agentflow",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "node scripts/test-coverage.mjs",
    "build": "tsc -p tsconfig.json",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:smoke": "node scripts/validate-smoke.mjs",
    "validate:confidence": "node scripts/validate-confidence.mjs",
    "validate:real-harness": "node scripts/validate-real-harness.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21"
  }
}
