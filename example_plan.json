{
  "version": "1",
  "setup": "Demonstrate all supported flow node types with the simplified task schema.",
  "objective": "Complete implementation and validation tasks with deterministic and AI-gated loops.",
  "target": {
    "repo_root": ".",
    "use_worktrees": true
  },
  "defaults": {
    "provider": "codex",
    "model": "gpt-5-nano",
    "reasoning": "high"
  },
  "policy": {
    "fail_mode": "stop",
    "max_iterations": 6,
    "max_runtime_sec": 14400,
    "max_total_tasks": 30,
    "max_failures": 4,
    "retry": {
      "max_retries": 1,
      "retry_on": ["FAILED", "TIMEOUT"]
    }
  },
  "runtime": {
    "run_root": "tmp/agentflow_runs",
    "cleanup_worktrees": true,
    "worker_timeout_sec": 1800,
    "timeout_grace_sec": 20,
    "max_parallel_tasks": 2
  },
  "context_files": [
    "README.md"
  ],
  "flow": [
    {
      "type": "task",
      "id": "analyze_requirements",
      "prompt": "Read README.md and summarize a concrete implementation plan before changing code."
    },
    {
      "type": "task",
      "id": "implement_small_change",
      "prompt": "Implement one focused improvement and include a short change summary in the report.",
      "provider": "codex",
      "model": "gpt-5",
      "context_files": [
        "src/cli.ts",
        "src/lib/types.ts"
      ]
    },
    {
      "type": "group",
      "id": "sequential_preflight",
      "parallel": false,
      "steps": [
        {
          "type": "task",
          "id": "inspect_workspace",
          "prompt": "Inspect the repository state and summarize what changed so far."
        },
        {
          "type": "task",
          "id": "prep_validation",
          "prompt": "Prepare a quick validation checklist before running tests."
        }
      ]
    },
    {
      "type": "group",
      "id": "parallel_validation",
      "parallel": true,
      "steps": [
        {
          "type": "task",
          "id": "run_unit_tests",
          "prompt": "Run npm test and summarize outcomes. Return DONE only if tests are green.",
          "context_files": ["package.json"]
        },
        {
          "type": "task",
          "id": "run_typecheck",
          "prompt": "Run npm run typecheck and summarize outcomes. Return DONE only if clean."
        }
      ]
    },
    {
      "type": "loop",
      "id": "deterministic_exit_example",
      "max_iterations": 2,
      "gate": {
        "type": "deterministic",
        "id": "deterministic_repo_sanity",
        "command": "node",
        "args": [
          "-e",
          "const fs=require('node:fs'); const pass=fs.existsSync('README.md'); console.log(JSON.stringify({passed:pass,score:pass?1:0,reasons:pass?['README.md exists']:['README.md missing']}));"
        ],
        "timeout_sec": 30,
        "required_artifacts": [
          "README.md"
        ]
      },
      "body": [
        {
          "type": "task",
          "id": "fix_repo_sanity",
          "prompt": "Repair repository sanity issues so the deterministic gate can pass."
        }
      ]
    },
    {
      "type": "loop",
      "id": "ai_quality_loop_example",
      "max_iterations": 3,
      "gate": {
        "type": "ai",
        "id": "quality_gate",
        "prompt": "Inspect recent workflow results and decide if the objective is complete. Return JSON only.",
        "provider": "codex",
        "model": "gpt-5-nano",
        "reasoning": "high",
        "include_recent_tasks": 10,
        "timeout_sec": 180,
        "score_threshold": 0.9,
        "required_artifacts": [
          "src/cli.ts"
        ]
      },
      "body": [
        {
          "type": "task",
          "id": "address_quality_feedback",
          "prompt": "Apply the highest-impact improvement suggested by prior task outputs."
        }
      ]
    }
  ]
}
