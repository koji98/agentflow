{
  "profile": "default",
  "prompts": {
    "planner": "docs/supervisor/planner.default.md",
    "plan_qa": "docs/supervisor/plan_qa.default.md"
  },
  "rubrics": {
    "plan_qa": "docs/supervisor/plan_qa_rubric.default.json"
  },
  "thresholds": {
    "plan_qa_pass_score": 0.85,
    "max_planner_revisions": 4
  },
  "paths": {
    "mission_state": "state/mission_state.json",
    "plan_candidate": "state/plan_candidate.json",
    "plan_rationale": "state/plan_rationale.md",
    "plan_score": "state/plan_score.json",
    "run_ledger": "state/run_ledger.jsonl",
    "run_root": "tmp/agentflow_supervisor_runs",
    "stop_flag": "state/stop.flag"
  },
  "execute_approved_plan": true,
  "agents": {
    "planner": {
      "provider": "codex",
      "model": "gpt-5-nano",
      "reasoning": "xhigh",
      "profile": null,
      "sandbox_mode": "workspace-write",
      "skip_git_repo_check": false
    },
    "plan_qa": {
      "provider": "codex",
      "model": "gpt-5-nano",
      "reasoning": "xhigh",
      "profile": null,
      "sandbox_mode": "workspace-write",
      "skip_git_repo_check": false
    }
  }
}
