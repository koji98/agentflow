{
  "name": "agentflow-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx server/index.ts",
    "dev:client": "vite",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:server && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server-build/web-app/server/index.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
