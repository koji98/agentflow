{
  "version": "1",
  "graph_id": "fake-plan-demo",
  "repos": {
    "main": {
      "path": "../../..",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "inplace"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5.4-codex",
      "reasoning_effort": "medium",
      "sandbox": "read-only",
      "timeout_sec": 900,
      "input_rules": {
        "max_total_tokens": 64000,
        "max_tokens_per_item": 32000
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "agent",
        "id": "inspect_repo",
        "repo": "main",
        "goal": "Inspect this repository and summarize what it does, the main CLI commands a developer would use first, and any obvious operator-facing constraints.",
        "constraints": [
          "Do not modify files."
        ],
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "package",
            "from": "workspace_file",
            "path": "package.json"
          },
          {
            "name": "scope",
            "from": "workspace_file",
            "path": "docs/SCOPE.md"
          }
        ]
      },
      {
        "type": "check",
        "id": "verify_package_contract",
        "repo": "main",
        "check_kind": "deterministic",
        "command": "node",
        "args": [
          "-e",
          "const fs=require('node:fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const workspaces=Array.isArray(pkg.workspaces)?pkg.workspaces:[]; const passed=pkg.name==='agentflow' && workspaces.includes('web-app'); console.log(JSON.stringify({passed, package_name: pkg.name, workspace_count: workspaces.length}, null, 2));"
        ],
        "pass_if": {
          "json_path": "$.passed",
          "equals": true
        }
      },
      {
        "type": "agent",
        "id": "summarize_findings",
        "repo": "main",
        "goal": "Write a concise handoff summary of the repository. Mention the package name, the main graph validation command, and whether the package metadata looks coherent for local testing.",
        "constraints": [
          "Do not modify files."
        ],
        "context": [
          {
            "ref": "inspect_repo.agent_response",
            "name": "inspection_response"
          },
          {
            "ref": "verify_package_contract.verification_json",
            "name": "package_contract_result"
          }
        ]
      }
    ]
  },
  "intent": {
    "goal": "Inspect the Agentflow repository and return a concise, reviewable handoff.",
    "acceptance_criteria": [
      "Repository purpose and first validation commands are clear.",
      "The run remains read-only."
    ],
    "constraints": [
      "Do not modify repository files."
    ]
  },
  "supervision": {
    "allowed_actions": [
      "retry_node",
      "repair_artifact",
      "rebuild_context",
      "run_diagnostic",
      "semantic_evaluation",
      "escalate"
    ],
    "retry_budget": {
      "max_total_interventions": 6,
      "max_node_retries": 2,
      "max_artifact_repairs": 2,
      "max_context_rebuilds": 1,
      "max_workspace_refreshes": 1,
      "max_diagnostic_runs": 2,
      "max_semantic_evaluations": 1
    },
    "drift_detection": {
      "score_threshold": 0.8
    },
    "escalation": {
      "require_human_on_policy_breach": true,
      "require_human_on_scope_drift": true
    }
  }
}
