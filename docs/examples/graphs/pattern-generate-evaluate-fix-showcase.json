{
  "version": "1",
  "graph_id": "pattern-generate-evaluate-fix-showcase",
  "repos": {
    "main": {
      "path": "../../.."
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "workspace-write",
      "timeout_sec": 1200,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "pattern_spec_design",
        "id": "managed_nodes_spec",
        "repo": "main",
        "profile": "default",
        "brief": {
          "problem": "Agentflow needs true managed patterns instead of thin aliases.",
          "goal": "Design the first implementation-ready managed pattern model for Agentflow.",
          "constraints": [
            "Keep primitive graph nodes stable.",
            "Managed patterns must compile into primitive subgraphs.",
            "The README should remain enough to get started."
          ],
          "decision_drivers": [
            "clarity",
            "reliability",
            "operator ergonomics"
          ],
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "tests/**"
            ],
            "areas": [
              "graph",
              "managed patterns",
              "docs"
            ]
          }
        },
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "managed_patterns_doc",
            "from": "workspace_file",
            "path": "docs/product/managed-patterns.md"
          },
          {
            "name": "generate_evaluate_fix_doc",
            "from": "workspace_file",
            "path": "docs/product/patterns/generate-evaluate-fix.md"
          }
        ],
        "context_policy": {
          "repo_first": true,
          "allow_web_fallback": false
        },
        "approval_policy": {
          "require_direction_approval": false
        },
        "strategy": {
          "alternatives": 2,
          "critique_profiles": [
            "architecture",
            "implementation"
          ],
          "max_revision_cycles": 2
        },
        "delivery": {
          "sections": [
            "problem",
            "requirements",
            "recommendation",
            "architecture",
            "file_plan",
            "acceptance_criteria",
            "risks",
            "open_questions"
          ]
        }
      },
      {
        "type": "pattern_generate_evaluate_fix",
        "id": "implement_managed_nodes",
        "repo": "main",
        "profile": "default",
        "brief": {
          "objective": "Implement the managed pattern model described by the upstream design packet.",
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "tests/**"
            ],
            "areas": [
              "graph",
              "managed patterns",
              "docs"
            ]
          }
        },
        "task_source": {
          "kind": "managed_node",
          "node": "managed_nodes_spec"
        },
        "context_policy": {
          "allow_official_docs_fallback": true,
          "allow_domains": [
            "developers.openai.com",
            "react.dev"
          ]
        },
        "strategy": {
          "max_fix_cycles": 2
        },
        "evaluation": {
          "commands": [
            "npm run typecheck",
            "npm test"
          ],
          "required": true
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "profile": "default",
        "goal": "Summarize the final change package for an operator who needs the outcome, evaluation status, and residual risks.",
        "context": [
          {
            "ref": "implement_managed_nodes.agent_response",
            "name": "implementation_response"
          },
          {
            "ref": "implement_managed_nodes.change_summary",
            "name": "change_summary"
          },
          {
            "ref": "implement_managed_nodes.evaluation_ledger",
            "name": "evaluation_ledger"
          }
        ]
      }
    ]
  },
  "intent": {
    "goal": "Implement and evaluate a managed pattern change from a design packet.",
    "acceptance_criteria": [
      "The change package includes a summary, evaluation ledger, and fix log."
    ],
    "constraints": [
      "Only modify files inside the declared paths."
    ]
  },
  "supervision": {
    "actions": {
      "retry_with_guidance": { "max_uses": 2 },
      "repair_artifact": { "max_uses": 2 },
      "rebuild_context": { "max_uses": 1 },
      "run_diagnostic": { "max_uses": 2 },
      "pause_for_human": { "max_uses": 1 },
      "semantic_evaluation": { "max_uses": 1 }
    },
    "max_total_interventions": 6,
    "policy": {
      "pause_on_policy_risk": true,
      "pause_on_repeated_recovery": true,
      "drift_score_threshold": 0.8
    }
  }
}
