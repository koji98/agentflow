{
  "version": "1",
  "graph_id": "pattern-deep-research-showcase",
  "repos": {
    "main": {
      "path": "../../..",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "read-only",
      "timeout_sec": 1200,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "pattern_deep_research",
        "id": "managed_patterns_research",
        "repo": "main",
        "profile": "default",
        "brief": {
          "question": "What should Agentflow's first managed patterns be and how should deep research behave?",
          "objective": "Produce a grounded recommendation for Agentflow's managed pattern roadmap.",
          "audience": "engineering",
          "scope_cues": [
            "managed pattern contracts",
            "compiled subgraph behavior"
          ],
          "success_bar": [
            "capture competing agent patterns",
            "preserve uncertainty and contradictions"
          ]
        },
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "managed_patterns_doc",
            "from": "workspace_file",
            "path": "docs/MANAGED_PATTERNS.md"
          }
        ],
        "context_policy": {
          "web": true,
          "files": true,
          "apps": false,
          "allow_domains": [
            "openai.com",
            "help.openai.com",
            "developers.openai.com",
            "google.com",
            "anthropic.com",
            "perplexity.ai"
          ]
        },
        "approval_policy": {
          "require_plan_approval": false
        },
        "strategy": {
          "depth": "standard",
          "coverage_mode": "balanced",
          "followup_passes": 1,
          "final_critique": true
        },
        "delivery": {
          "format": "report",
          "citation_style": "inline",
          "sections": [
            "patterns",
            "proposed managed patterns",
            "deep research design",
            "recommendation"
          ]
        },
        "runtime": {
          "max_concurrency": 2
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "profile": "default",
        "prompt": "Summarize the deep research result for a human operator. Mention the question, the recommended managed patterns, and the command a user should run next to inspect the graph.",
        "context": [
          {
            "name": "research_response",
            "from": "artifact",
            "node": "managed_patterns_research",
            "artifact": "agent_response"
          },
          {
            "name": "research_report",
            "from": "artifact",
            "node": "managed_patterns_research",
            "artifact": "research_report"
          }
        ]
      }
    ]
  }
}
