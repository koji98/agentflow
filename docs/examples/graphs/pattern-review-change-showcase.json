{
  "version": "1",
  "graph_id": "pattern-review-change-showcase",
  "repos": {
    "main": {
      "path": "../../.."
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "workspace-write",
      "timeout_sec": 1200,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "pattern_spec_design",
        "id": "managed_nodes_spec",
        "repo": "main",
        "profile": "default",
        "brief": {
          "problem": "Agentflow needs true managed patterns instead of thin aliases.",
          "goal": "Design the first implementation-ready managed pattern model for Agentflow.",
          "constraints": [
            "Keep primitive graph nodes stable.",
            "Managed patterns must compile into primitive subgraphs.",
            "The review workflow should publish machine-readable findings."
          ],
          "decision_drivers": [
            "clarity",
            "reliability",
            "review quality"
          ],
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "tests/**"
            ],
            "areas": [
              "graph",
              "managed patterns",
              "docs"
            ]
          }
        },
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "managed_patterns_doc",
            "from": "workspace_file",
            "path": "docs/MANAGED_PATTERNS.md"
          },
          {
            "name": "review_change_doc",
            "from": "workspace_file",
            "path": "docs/PATTERN_REVIEW_CHANGE.md"
          }
        ],
        "context_policy": {
          "repo_first": true,
          "allow_web_fallback": false
        },
        "approval_policy": {
          "require_direction_approval": false
        },
        "strategy": {
          "alternatives": 2,
          "critique_profiles": [
            "architecture",
            "implementation"
          ],
          "max_revision_cycles": 2
        }
      },
      {
        "type": "pattern_generate_evaluate_fix",
        "id": "implement_managed_nodes",
        "repo": "main",
        "profile": "default",
        "brief": {
          "objective": "Implement the managed pattern model described by the upstream design packet.",
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "tests/**"
            ],
            "areas": [
              "graph",
              "managed patterns",
              "docs"
            ]
          }
        },
        "task_source": {
          "kind": "managed_node",
          "node": "managed_nodes_spec"
        },
        "context_policy": {
          "allow_official_docs_fallback": true
        },
        "strategy": {
          "max_fix_cycles": 2
        },
        "evaluation": {
          "commands": [
            "npm run typecheck",
            "npm test"
          ],
          "required": true
        }
      },
      {
        "type": "pattern_review_change",
        "id": "review_managed_nodes",
        "repo": "main",
        "profile": "default",
        "review_source": {
          "kind": "managed_node",
          "node": "implement_managed_nodes"
        },
        "brief": {
          "review_goal": "Review the implementation for high-signal defects and missing tests.",
          "focus": [
            "correctness",
            "testing",
            "maintainability"
          ],
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "tests/**"
            ],
            "areas": [
              "graph",
              "managed patterns",
              "docs"
            ]
          }
        },
        "context_policy": {
          "include_surrounding_code": true,
          "include_tests": true,
          "include_docs": true,
          "include_validation": true
        },
        "strategy": {
          "reviewer_profiles": [
            "correctness",
            "testing",
            "maintainability"
          ],
          "severity_policy": "balanced",
          "include_surrounding_context": true,
          "false_positive_challenge": true,
          "require_file_references": true
        },
        "delivery": {
          "format": "review_summary",
          "sections": [
            "findings",
            "severity_summary",
            "recommended_actions"
          ]
        },
        "runtime": {
          "max_concurrency": 2
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "profile": "default",
        "goal": "Summarize the final review for an implementer. Focus on the highest-priority findings, their likely impact, and any evaluation or residual-risk context from upstream stages.",
        "context": [
          {
            "ref": "review_managed_nodes.agent_response",
            "name": "review_response"
          },
          {
            "ref": "review_managed_nodes.review_summary",
            "name": "review_summary"
          },
          {
            "ref": "review_managed_nodes.calibrated_findings",
            "name": "calibrated_findings"
          }
        ]
      }
    ]
  },
  "intent": {
    "goal": "Review a generated Agentflow change and publish calibrated findings.",
    "acceptance_criteria": [
      "The review package includes findings, severity, and recommended actions."
    ],
    "constraints": [
      "Review only the declared change package."
    ]
  },
  "supervision": {
    "actions": {
      "retry_with_guidance": { "max_uses": 2 },
      "repair_artifact": { "max_uses": 2 },
      "rebuild_context": { "max_uses": 1 },
      "run_diagnostic": { "max_uses": 2 },
      "pause_for_human": { "max_uses": 1 },
      "semantic_evaluation": { "max_uses": 1 }
    },
    "max_total_interventions": 6,
    "policy": {
      "pause_on_policy_risk": true,
      "pause_on_repeated_recovery": true,
      "drift_score_threshold": 0.8
    }
  }
}
