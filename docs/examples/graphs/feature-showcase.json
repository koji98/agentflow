{
  "version": "1",
  "graph_id": "feature-showcase",
  "repos": {
    "main": {
      "path": "../../..",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "read-only",
      "timeout_sec": 900,
      "input_rules": {
        "max_total_tokens": 96000,
        "max_tokens_per_item": 32000
      }
    },
    "analysis": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "high",
      "sandbox": "read-only",
      "timeout_sec": 1200,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    },
    "review": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "read-only",
      "timeout_sec": 900,
      "ai_check_defaults": {
        "model": "gpt-5-codex",
        "reasoning_effort": "medium"
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "agent",
        "id": "survey_repo",
        "repo": "main",
        "profile": "analysis",
        "prompt": "Inspect this repository and summarize the product shape, the main CLI workflow, and any operator-facing constraints. Do not modify files.",
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "docs",
            "from": "workspace_glob",
            "path": "docs/*.md",
            "max_files": 4
          },
          {
            "name": "demo_goal",
            "from": "text",
            "text": "Produce a feature showcase run that stays read-only and easy to inspect."
          }
        ],
        "artifacts": {
          "survey_notes": {
            "from": "output_dir",
            "path": "survey-notes.md",
            "description": "Markdown notes from the repository survey."
          }
        }
      },
      {
        "type": "parallel",
        "id": "preflight",
        "max_concurrency": 2,
        "steps": [
          {
            "type": "exec",
            "id": "print_package_summary",
            "repo": "main",
            "command": "node",
            "args": [
              "-e",
              "const fs=require('node:fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); console.log(JSON.stringify({name: pkg.name, scripts: Object.keys(pkg.scripts).slice(0, 8)}, null, 2));"
            ]
          },
          {
            "type": "check",
            "id": "verify_package_contract",
            "repo": "main",
            "check_kind": "deterministic",
            "command": "node",
            "args": [
              "-e",
              "const fs=require('node:fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const passed=pkg.name==='agentflow' && typeof pkg.scripts?.validate==='string' && typeof pkg.scripts?.compile==='string' && typeof pkg.scripts?.run==='string'; console.log(JSON.stringify({passed, package_name: pkg.name, has_validate: typeof pkg.scripts?.validate==='string', has_compile: typeof pkg.scripts?.compile==='string', has_run: typeof pkg.scripts?.run==='string'}, null, 2));"
            ],
            "pass_if": {
              "json_path": "$.passed",
              "equals": true
            },
            "artifacts": {
              "package_contract": {
                "from": "output_dir",
                "path": "result.json",
                "description": "Structured JSON result from the package contract check."
              }
            }
          }
        ]
      },
      {
        "type": "agent",
        "id": "synthesize_constraints",
        "repo": "main",
        "profile": "analysis",
        "prompt": "Using the repository survey and package contract output, write a concise set of constraints and observations that a human operator should know before running a graph in this repository. Do not modify files.",
        "context": [
          {
            "name": "survey_response",
            "from": "artifact",
            "node": "survey_repo",
            "artifact": "agent_response"
          },
          {
            "name": "package_contract",
            "from": "artifact",
            "node": "verify_package_contract",
            "artifact": "package_contract"
          }
        ],
        "artifacts": {
          "constraints_brief": {
            "from": "output_dir",
            "path": "constraints-brief.md",
            "description": "Markdown constraints and observations for running Agentflow in this repository."
          }
        }
      },
      {
        "type": "repeat",
        "id": "quality_loop",
        "max_attempts": 2,
        "body": {
          "type": "sequence",
          "id": "quality_body",
          "steps": [
            {
              "type": "agent",
              "id": "draft_walkthrough",
              "repo": "main",
              "profile": "analysis",
              "prompt": "Draft a concise operator walkthrough for this repository that explains how to validate, compile, run, and inspect a graph. Keep it read-only and do not modify files.",
              "context": [
                {
                  "name": "constraints_response",
                  "from": "artifact",
                  "node": "synthesize_constraints",
                  "artifact": "agent_response"
                },
                {
                  "name": "survey_response",
                  "from": "artifact",
                  "node": "survey_repo",
                  "artifact": "agent_response"
                }
              ],
              "artifacts": {
                "walkthrough_draft": {
                  "from": "output_dir",
                  "path": "walkthrough-draft.md",
                  "description": "Markdown draft of the operator walkthrough."
                }
              }
            },
            {
              "type": "agent",
              "id": "tighten_walkthrough",
              "repo": "main",
              "profile": "review",
              "prompt": "Review the drafted walkthrough, tighten weak spots, and make sure it clearly explains the CLI order, the role of the web UI, and the read-only nature of this showcase. Do not modify files.",
              "context": [
                {
                  "name": "draft_response",
                  "from": "artifact",
                  "node": "draft_walkthrough",
                  "artifact": "agent_response"
                },
                {
                  "name": "failed_review_report",
                  "from": "artifact",
                  "node": "review_walkthrough",
                  "artifact": "review_report",
                  "iteration": "latest_failed",
                  "optional": true
                },
                {
                  "name": "package_contract_result",
                  "from": "artifact",
                  "node": "verify_package_contract",
                  "artifact": "result_json"
                }
              ],
              "artifacts": {
                "walkthrough_final": {
                  "from": "output_dir",
                  "path": "walkthrough-final.md",
                  "description": "Markdown final walkthrough after review tightening."
                }
              }
            },
            {
              "type": "check",
              "id": "review_walkthrough",
              "repo": "main",
              "profile": "review",
              "check_kind": "ai",
              "prompt": "Review the current walkthrough and decide whether it is clear, concrete, and sufficient for a developer to validate, compile, run, and inspect a graph in this repository.",
              "rubric": "Pass only if the walkthrough clearly mentions validate, compile, run, and ui or web monitor flow, accurately describes the repository as local-first, and does not claim the showcase edits files. Fail if any of those are missing or misleading.",
              "context": [
                {
                  "name": "walkthrough_response",
                  "from": "artifact",
                  "node": "tighten_walkthrough",
                  "artifact": "agent_response"
                },
                {
                  "name": "constraints_response",
                  "from": "artifact",
                  "node": "synthesize_constraints",
                  "artifact": "agent_response"
                }
              ],
              "artifacts": {
                "review_report": {
                  "from": "output_dir",
                  "path": "result.json",
                  "description": "Structured JSON AI review result for the walkthrough."
                }
              }
            }
          ]
        },
        "until": {
          "node": "review_walkthrough"
        }
      },
      {
        "type": "agent",
        "id": "final_handoff",
        "repo": "main",
        "profile": "default",
        "prompt": "Produce a final handoff that explains what this showcase run demonstrated. Mention the graph version, the node kinds used, the profile strategy, the deterministic package contract check, the AI walkthrough review, and the final commands a user would run next. Do not modify files.",
        "context": [
          {
            "name": "survey_response",
            "from": "artifact",
            "node": "survey_repo",
            "artifact": "agent_response"
          },
          {
            "name": "package_contract",
            "from": "artifact",
            "node": "verify_package_contract",
            "artifact": "package_contract"
          },
          {
            "name": "review_report",
            "from": "artifact",
            "node": "review_walkthrough",
            "artifact": "review_report",
            "iteration": "latest_passed"
          }
        ]
      }
    ]
  }
}
