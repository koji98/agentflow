{
  "version": "1",
  "graph_id": "pattern-spec-design-showcase",
  "repos": {
    "main": {
      "path": "../../..",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "workspace-write",
      "timeout_sec": 1200,
      "input_rules": {
        "max_total_tokens": 128000,
        "max_tokens_per_item": 32000
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "pattern_spec_design",
        "id": "managed_nodes_spec",
        "repo": "main",
        "profile": "default",
        "brief": {
          "problem": "Agentflow needs true managed patterns instead of thin aliases.",
          "goal": "Design the first implementation-ready managed pattern model for Agentflow.",
          "audience": "engineering",
          "constraints": [
            "Keep primitive graph nodes stable.",
            "Managed patterns must compile into primitive subgraphs.",
            "The UI must eventually support collapsed and expanded managed pattern views."
          ],
          "decision_drivers": [
            "clarity",
            "reliability",
            "extensibility",
            "operator ergonomics"
          ],
          "scope": {
            "paths": [
              "src/**",
              "docs/**",
              "web-app/**"
            ],
            "areas": [
              "graph",
              "runtime",
              "ui"
            ]
          }
        },
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          },
          {
            "name": "managed_patterns_doc",
            "from": "workspace_file",
            "path": "docs/product/managed-patterns.md"
          },
          {
            "name": "spec_design_doc",
            "from": "workspace_file",
            "path": "docs/product/patterns/spec-design.md"
          }
        ],
        "context_policy": {
          "repo_first": true,
          "allow_web_fallback": true,
          "web_triggers": [
            "missing_pattern",
            "missing_domain_context",
            "missing_library_guidance",
            "missing_product_reference"
          ],
          "allow_domains": [
            "openai.com",
            "help.openai.com",
            "developers.openai.com",
            "react.dev"
          ]
        },
        "approval_policy": {
          "require_direction_approval": false
        },
        "strategy": {
          "alternatives": 3,
          "critique_profiles": [
            "architecture",
            "implementation",
            "ux"
          ],
          "max_revision_cycles": 2
        },
        "delivery": {
          "format": "design_spec",
          "sections": [
            "problem",
            "current_state",
            "requirements",
            "options",
            "recommendation",
            "architecture",
            "file_plan",
            "acceptance_criteria",
            "risks",
            "open_questions"
          ]
        },
        "runtime": {
          "max_concurrency": 2
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "profile": "default",
        "goal": "Summarize the final design package for a human operator. Mention the problem, the recommendation, and the artifacts a follow-on pattern_generate_evaluate_fix pattern would likely consume.",
        "context": [
          {
            "ref": "managed_nodes_spec.agent_response",
            "name": "design_response"
          },
          {
            "ref": "managed_nodes_spec.design_spec",
            "name": "design_spec"
          },
          {
            "ref": "managed_nodes_spec.implementation_readiness",
            "name": "implementation_readiness",
            "if_available": true
          }
        ]
      }
    ]
  },
  "intent": {
    "goal": "Design an implementation-ready Agentflow managed pattern package.",
    "acceptance_criteria": [
      "The design package is implementation-ready and reviewable."
    ],
    "constraints": [
      "Do not expand repository scope beyond declared paths."
    ]
  },
  "supervision": {
    "actions": {
      "retry_with_guidance": { "max_uses": 2 },
      "repair_artifact": { "max_uses": 2 },
      "rebuild_context": { "max_uses": 1 },
      "run_diagnostic": { "max_uses": 2 },
      "pause_for_human": { "max_uses": 1 },
      "semantic_evaluation": { "max_uses": 1 }
    },
    "max_total_interventions": 6,
    "policy": {
      "pause_on_policy_risk": true,
      "pause_on_repeated_recovery": true,
      "drift_score_threshold": 0.8
    }
  }
}
