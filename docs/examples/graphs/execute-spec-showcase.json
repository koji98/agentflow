{
  "version": "1",
  "graph_id": "execute-spec-showcase",
  "repos": {
    "main": {
      "path": "../../.."
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "worktree"
  },
  "profiles": {
    "default": {
      "harness": "codex-cli",
      "model": "gpt-5-codex",
      "reasoning_effort": "medium",
      "sandbox": "read-only",
      "timeout_sec": 1200,
      "input_rules": {
        "max_files": 16,
        "max_total_bytes": 524288,
        "max_bytes_per_item": 131072
      }
    }
  },
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "spec_design",
        "id": "managed_nodes_spec",
        "repo": "main",
        "profile": "default",
        "problem": "Agentflow needs true managed workflows instead of thin aliases.",
        "goal": "Design the first implementation-ready managed workflow model for Agentflow.",
        "inputs": [
          {
            "kind": "file",
            "path": "README.md"
          },
          {
            "kind": "file",
            "path": "docs/MANAGED_WORKFLOWS.md"
          },
          {
            "kind": "file",
            "path": "docs/EXECUTE_SPEC_WORKFLOW.md"
          }
        ],
        "constraints": [
          "Keep primitive graph nodes stable.",
          "Managed workflows must compile into primitive subgraphs.",
          "The README should remain enough to get started."
        ],
        "decision_drivers": [
          "clarity",
          "reliability",
          "operator ergonomics"
        ],
        "scope": {
          "paths": [
            "src/**",
            "docs/**",
            "tests/**"
          ],
          "areas": [
            "graph",
            "managed workflows",
            "docs"
          ]
        },
        "research_policy": {
          "allow_web_fallback": false,
          "max_external_research_tasks": 0
        },
        "deliverable": {
          "sections": [
            "problem",
            "requirements",
            "recommendation",
            "architecture",
            "file_plan",
            "acceptance_criteria",
            "risks",
            "open_questions"
          ]
        },
        "orchestration": {
          "option_count": 2,
          "max_parallel_options": 2,
          "critique_roles": [
            "architecture",
            "implementation"
          ],
          "revision_rounds": 2
        }
      },
      {
        "type": "execute_spec",
        "id": "implement_managed_nodes",
        "repo": "main",
        "profile": "default",
        "objective": "Implement the managed workflow model described by the upstream spec.",
        "spec_source": {
          "kind": "managed_node",
          "node": "managed_nodes_spec"
        },
        "scope": {
          "paths": [
            "src/**",
            "docs/**",
            "tests/**"
          ],
          "areas": [
            "graph",
            "managed workflows",
            "docs"
          ]
        },
        "execution_policy": {
          "max_repair_rounds": 2
        },
        "validation": {
          "commands": [
            "npm run typecheck",
            "npm test"
          ],
          "required": true
        },
        "implementation_research": {
          "allow_official_docs_fallback": true,
          "allow_domains": [
            "developers.openai.com",
            "react.dev"
          ],
          "max_external_lookup_tasks": 1
        },
        "delivery": {
          "write_change_summary": true,
          "write_validation_results": true,
          "write_residual_risks": true,
          "write_files_touched": true,
          "write_implementation_plan": true
        }
      },
      {
        "type": "agent",
        "id": "handoff",
        "repo": "main",
        "profile": "default",
        "prompt": "Summarize the final implementation handoff for an operator who needs the outcome, validation status, and residual risks.",
        "context_from": [
          {
            "node": "implement_managed_nodes",
            "include": "summary"
          },
          {
            "node": "implement_managed_nodes",
            "include": "output",
            "output": "change_summary"
          },
          {
            "node": "implement_managed_nodes",
            "include": "output",
            "output": "validation_results"
          },
          {
            "node": "implement_managed_nodes",
            "include": "output",
            "output": "residual_risks",
            "optional": true
          }
        ]
      }
    ]
  }
}
