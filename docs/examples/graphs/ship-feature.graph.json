{
  "version": "1",
  "graph_id": "ship-feature-tools-demo",
  "repos": {
    "main": {
      "path": "../../..",
      "default_branch": "main"
    }
  },
  "defaults": {
    "launch_profile": "default",
    "workspace_backend": "inplace"
  },
  "profiles": {
    "default": {
      "harness": "cursor-cli",
      "model": "auto",
      "sandbox": "workspace-write",
      "timeout_sec": 900,
      "input_rules": {
        "max_total_tokens": 96000,
        "max_tokens_per_item": 32000
      }
    },
    "review": {
      "harness": "cursor-cli",
      "model": "auto",
      "sandbox": "workspace-write",
      "timeout_sec": 900
    }
  },
  "plugins": {
    "babysit": {
      "path": "../plugins/babysit"
    }
  },
  "tools": [
    {
      "from_plugin": "babysit",
      "tool": "poll"
    }
  ],
  "graph": {
    "type": "sequence",
    "id": "root",
    "steps": [
      {
        "type": "agent",
        "id": "draft_release_notes",
        "repo": "main",
        "prompt": "Draft a tight, well-structured release-notes section that covers the most recent changes summarized from the README. Write the markdown body to `release-notes.md` inside the agentflow output directory ($AGENTFLOW_OUTPUT_DIR). Do not modify files in the repository.",
        "context": [
          {
            "name": "readme",
            "from": "workspace_file",
            "path": "README.md"
          }
        ],
        "artifacts": {
          "release_notes": {
            "from": "output_dir",
            "path": "release-notes.md",
            "description": "Draft release-notes section produced by the agent."
          }
        }
      },
      {
        "type": "agent",
        "id": "watch_pr",
        "repo": "main",
        "profile": "review",
        "prompt": "Use the `babysit-poll` plugin tool to fetch the current state of pull request `123` (call `babysit-poll --pr 123`). Combine the polled JSON with the release-notes draft to produce a short ship-readiness handoff. Write it to `ship-handoff.md` inside the agentflow output directory ($AGENTFLOW_OUTPUT_DIR). Do not modify files in the repository.",
        "context": [
          {
            "ref": "draft_release_notes.release_notes",
            "name": "release_notes"
          }
        ],
        "artifacts": {
          "ship_handoff": {
            "from": "output_dir",
            "path": "ship-handoff.md",
            "description": "Final ship-readiness handoff combining release notes and PR status."
          }
        }
      }
    ]
  },
  "intent": {
    "goal": "Draft and verify release notes using Codex/Cursor-compatible plugin tooling.",
    "scope": {
      "repos": [
        "main"
      ],
      "paths": [
        "README.md",
        "docs/**"
      ]
    },
    "acceptance_criteria": [
      "Release notes are produced as a named artifact.",
      "The plugin tool contract is visible to the agent."
    ],
    "approval_boundaries": [
      "Do not publish or mutate remote services from this demo graph."
    ]
  },
  "supervision": {
    "allowed_actions": [
      "retry_node",
      "repair_artifact",
      "rebuild_context",
      "run_diagnostic",
      "semantic_evaluation",
      "escalate"
    ],
    "retry_budget": {
      "max_total_interventions": 6,
      "max_node_retries": 2,
      "max_artifact_repairs": 2,
      "max_context_rebuilds": 1,
      "max_workspace_refreshes": 1,
      "max_diagnostic_runs": 2,
      "max_semantic_evaluations": 1
    },
    "drift_detection": {
      "score_threshold": 0.8
    },
    "escalation": {
      "require_human_on_policy_breach": true,
      "require_human_on_scope_drift": true
    }
  },
  "delivery": {
    "required_sections": [
      "task_brief",
      "implementation_summary",
      "grouped_change_map",
      "decision_log",
      "evaluation_ledger",
      "reviewer_guide",
      "risk_notes",
      "follow_up_items",
      "intervention_trace"
    ]
  }
}
